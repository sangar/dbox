{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug with sanitizers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/debug",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "DBOX_SANITIZE": "ON"}
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    }
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "release", "configurePreset": "release"},
    {"name": "check", "configurePreset": "debug", "targets": ["check"]}
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {"outputOnFailure": true},
      "filter": {"exclude": {"label": "integration"}}
    },
    {
      "name": "integration",
      "configurePreset": "debug",
      "output": {"outputOnFailure": true},
      "filter": {"include": {"label": "integration"}}
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        {"type": "configure", "name": "debug"},
        {"type": "build", "name": "debug"},
        {"type": "test", "name": "debug"}
      ]
    }
  ]
}
